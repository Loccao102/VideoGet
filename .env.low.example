# VideoGet - LOW / weak CPU-RAM preset
# Target: 4-8 logical CPU threads, 8-16 GB RAM. Suitable for office laptops, mini PCs and integrated-graphics systems.
# GPU: not required; this preset assumes CPU-oriented processing.
# Storage: SSD recommended; NVMe preferred for medium/high tiers.
# Usage:
#   cp .env.low.example .env
#   docker compose up -d --build
#
# IMPORTANT:
# - "logical CPU threads" means the thread count shown by the OS, not physical cores.
# - Put real cookies/API keys only in local .env. Never commit them.
# - This preset prioritizes responsiveness and stability over maximum throughput/quality.

# -----------------------------------------------------------------------------
# Douyin discovery/download
# -----------------------------------------------------------------------------
DOUYIN_COOKIE=
DOUYIN_SEARCH_TIMEOUT_SEC=20
DOUYIN_SEARCH_URL=
DOUYIN_NATIVE_SEARCH=true
DOUYIN_NATIVE_SEARCH_SCRIPT=/app/scripts/douyin_search_browser_v2.py
DOUYIN_NATIVE_SEARCH_TIMEOUT_SEC=45
DOUYIN_NATIVE_SEARCH_RENDER_MS=10000
DOUYIN_NATIVE_SEARCH_SCROLLS=3
DOUYIN_NATIVE_SEARCH_MAX_PAGES=3
DOUYIN_NATIVE_SEARCH_DOM_MAX_MB=16
DOUYIN_NATIVE_SEARCH_PROFILE_DIR=
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
DOUYIN_MOBILE_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1
DOUYIN_RESOLVE_TIMEOUT_SEC=18
DOUYIN_PAGE_TIMEOUT_SEC=25
DOUYIN_MEDIA_TIMEOUT_SEC=120
DOUYIN_MEDIA_CANDIDATES=8
DOUYIN_PREFER_ORIGINAL=false

DOUYIN_BROWSER_FALLBACK=true
DOUYIN_BROWSER_BIN=chromium
DOUYIN_BROWSER_TIMEOUT_SEC=45
DOUYIN_BROWSER_RENDER_MS=8000
DOUYIN_BROWSER_DOM_MAX_MB=16
DOUYIN_BROWSER_NO_SANDBOX=true
DOUYIN_BROWSER_PROFILE_DIR=
DOUYIN_BROWSER_EXTRA_ARGS=

# -----------------------------------------------------------------------------
# Bilibili
# -----------------------------------------------------------------------------
BILIBILI_COOKIE=
BILIBILI_BIN=bili
BILIBILI_SEARCH_DELAY_MS=1500
BILIBILI_REQUEST_RATE=1000ms
BILIBILI_RETRIES=2
BILIBILI_DOWNLOAD_ATTEMPTS=3
BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36

# -----------------------------------------------------------------------------
# Other public short-video sources
# -----------------------------------------------------------------------------
AUTO_FREE_SOURCES=true
FREE_SHORT_SOURCES=kuaishou,xiaohongshu,weibo,xigua,haokan,toutiao,acfun,meipai,weishi
PUBLIC_SOURCE_KEYWORD_LIMIT=2
PUBLIC_INDEX_CONCURRENCY=3
PUBLIC_INDEX_TIMEOUT_SEC=10
PUBLIC_INDEX_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36
PUBLIC_DOWNLOAD_ATTEMPTS=2
PUBLIC_DOWNLOAD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36

# -----------------------------------------------------------------------------
# Preview + queue
# -----------------------------------------------------------------------------
PREVIEW_CONCURRENCY=2
PREVIEW_PAGE_TIMEOUT_SEC=5
PREVIEW_YTDLP_TIMEOUT_SEC=12
PREVIEW_DEEP_METADATA=false
PREVIEW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36

JOB_DB_PATH=/app/downloads/videoget.db
DOWNLOAD_CONCURRENCY=2
JOB_TIMEOUT_MINUTES=180

# -----------------------------------------------------------------------------
# Keyword expansion
# -----------------------------------------------------------------------------
# ollama = better Chinese keyword expansion but consumes local model resources.
# off = lower CPU/RAM usage and static keyword expansion only.
KEYWORD_EXPANDER=off
KEYWORD_EXPANDER_STRICT=false
OLLAMA_KEYWORD_TIMEOUT_SEC=20

# -----------------------------------------------------------------------------
# Localization / OCR
# -----------------------------------------------------------------------------
AUTO_LOCALIZE=true
LOCALIZE_SCRIPT=/app/scripts/localize_smart.py
# Number of videos allowed to enter localization at the same time.
# OCR, ffmpeg and Ollama can all compete for CPU/RAM, so do not increase this blindly.
LOCALIZE_CONCURRENCY=1
LOCALIZE_PERSISTENT_WORKER=true
LOCALIZE_WORKER_SCRIPT=/app/scripts/localize_worker_smart.py
LOCALIZE_WORKER_FALLBACK=true
LOCALIZE_WORKER_PREWARM=false
LOCALIZE_WORKER_START_TIMEOUT_SEC=600

OCR_SUBTITLE_SCRIPT=/app/scripts/localize_ocr_subtitles.py
OCR_MUSIC_SCRIPT=/app/scripts/localize_ocr_music.py
# OCR_MODEL_SIZE: tiny < small < medium in compute cost and expected text accuracy.
OCR_MODEL_SIZE=tiny
# Frames sampled per second for OCR. Doubling this is close to doubling OCR work on long clips.
OCR_FPS=2
# Hard ceiling for OCR frames so long videos cannot consume unbounded CPU time.
OCR_MAX_SAMPLES=360
OCR_MIN_CONFIDENCE=0.6
OCR_MIN_TEXT_CHARS=2
OCR_MIN_DURATION_SEC=0.4
OCR_TEXT_SIMILARITY=0.76
OCR_MAX_GAP_SEC=1
OCR_IGNORE_PERSISTENT_SEC=12
OCR_SUBTITLE_REGION=auto
OCR_LAYOUT_MIN_CONFIDENCE=0.58
OCR_SOURCE_LANGUAGE=zh
OCR_TRANSLATE=true
OCR_REMOVE_SOURCE_TEXT=true

# Clean Overlay is the default presentation:
# blur source characters + bold white Vietnamese text + dark outline/shadow.
# Alternatives supported by rerender: clean | capsule | box
OCR_OVERLAY_STYLE=clean
OCR_OVERLAY_SOURCE_BLUR=10

# Auto detect Bilibili uploader/channel text on either side and replace it with our brand.
OCR_OVERLAY_HIDE_BILIBILI=true
OCR_OVERLAY_BILIBILI_AUTO_DETECT=true
OCR_OVERLAY_BILIBILI_DECODE_PROXY=true
OCR_OVERLAY_BILIBILI_SAMPLES=3
OCR_OVERLAY_BILIBILI_TOP_BAND=0.20
OCR_OVERLAY_BILIBILI_OCR_CONFIDENCE=0.48
OCR_OVERLAY_BILIBILI_MIN_HITS=2
OCR_OVERLAY_BILIBILI_BLUR=15
OCR_OVERLAY_BILIBILI_REDETECT=false
OCR_OVERLAY_BILIBILI_MANUAL_REGIONS=
OCR_OVERLAY_BILIBILI_REGIONS=

BRAND_WATERMARK_ENABLED=true
BRAND_WATERMARK_TEXT=Xứ Sở Nhiều Lông
BRAND_WATERMARK_ASSET=
BRAND_WATERMARK_WIDTH=0.20
BRAND_WATERMARK_MARGIN_X=0.012
BRAND_WATERMARK_MARGIN_Y=0.012

# -----------------------------------------------------------------------------
# AV1/OpenCV compatibility proxy
# -----------------------------------------------------------------------------
# Only used when OCR/OpenCV cannot decode the original stream reliably.
# 0 threads = let ffmpeg choose automatically.
OCR_FORCE_DECODE_PROXY=false
OCR_DECODE_PROXY_PRESET=ultrafast
OCR_DECODE_PROXY_CRF=27
OCR_DECODE_PROXY_THREADS=2
OCR_KEEP_DECODE_PROXY=false

# -----------------------------------------------------------------------------
# OCR + Music
# -----------------------------------------------------------------------------
OCR_MUSIC_DIR=/app/assets/music
OCR_MUSIC_FILE=
OCR_MUSIC_REQUIRED=true
OCR_MUSIC_VOLUME=0.18
OCR_MUSIC_FADE_IN_SEC=0.8
OCR_MUSIC_FADE_OUT_SEC=1.5
OCR_ORIGINAL_AUDIO_MODE=mute
OCR_ORIGINAL_AUDIO_VOLUME=0.06
OCR_MUSIC_AUDIO_BITRATE=160k

# -----------------------------------------------------------------------------
# Whisper - speech modes only
# -----------------------------------------------------------------------------
# OCR-only modes do not run Whisper or TTS.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1
WHISPER_DIRECT_DECODE=true
WHISPER_CONDITION_PREVIOUS_TEXT=true
WHISPER_USE_TITLE_PROMPT=true
HF_TOKEN=

# -----------------------------------------------------------------------------
# Translation
# -----------------------------------------------------------------------------
TRANSLATE_PROVIDER=ollama
TRANSLATE_STYLE=natural_social
# Larger batches reduce HTTP/model-call overhead but consume more RAM/context.
TRANSLATE_BATCH_SIZE=6
TRANSLATE_CONTEXT_SEGMENTS=2
TRANSLATE_TEMPERATURE=0.15
TRANSLATE_TIMEOUT_SEC=240
TRANSLATE_RETRIES=2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_KEEP_ALIVE=5m

OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# -----------------------------------------------------------------------------
# Vietnamese TTS
# -----------------------------------------------------------------------------
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+8%
TTS_MAX_SPEED=2.0
TTS_CONCURRENCY=1
TTS_RETRIES=4
TTS_REQUEST_TIMEOUT_SEC=75
TTS_GROUP_MAX_CHARS=180
TTS_GROUP_MAX_DURATION_SEC=10
TTS_GROUP_MAX_GAP_SEC=1.2
TTS_FALLBACK_MAX_CHARS=90

# -----------------------------------------------------------------------------
# Final render
# -----------------------------------------------------------------------------
BURN_SUBTITLES=true
VIDEO_CLEANUP=true
VIDEO_CLEANUP_MODE=safe
# Number of frames used by visual-layout/logo analysis, not OCR sampling.
VIDEO_ANALYSIS_SAMPLES=8
VIDEO_CLEANUP_SOURCE_SUBTITLES=true
VIDEO_CLEANUP_LOGOS=true

VIDEO_SOURCE_SUBTITLE_BLUR=6
VIDEO_SOURCE_SUBTITLE_REGION=
VIDEO_MANUAL_LOGO_REGIONS=

VIDEO_SUBTITLE_FONT=Noto Sans
VIDEO_SUBTITLE_FONT_SIZE=
VIDEO_SUBTITLE_BOX_ALPHA=0.58
VIDEO_SUBTITLE_BOX_PADDING=7
VIDEO_SUBTITLE_WRAP_CHARS=
VIDEO_SUBTITLE_MAX_LINES=2

# Legacy-only fixed masks. Smart cleanup prefers detected geometry.
VIDEO_LOGO_MASKS=0.76,0.02,0.22,0.10;0.76,0.86,0.22,0.12
VIDEO_SUBTITLE_MASK_X=0.02
VIDEO_SUBTITLE_MASK_Y=0.72
VIDEO_SUBTITLE_MASK_W=0.96
VIDEO_SUBTITLE_MASK_H=0.24

VIDEO_COLOR_GRADE=false
VIDEO_CONTRAST=1.03
VIDEO_SATURATION=1.05
VIDEO_BRIGHTNESS=0.005
# libx264 preset trades CPU time for compression efficiency: ultrafast -> veryfast -> fast.
VIDEO_PRESET=ultrafast
# Lower CRF = higher quality/larger files; higher CRF = smaller/faster output.
VIDEO_CRF=23
ORIGINAL_AUDIO_VOLUME=0.08
