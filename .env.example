# Douyin web search/download requires a valid Cookie from your own logged-in browser session.
# Never commit a real cookie.
DOUYIN_COOKIE=

# Bilibili search uses bilibili-cli and is deliberately throttled to reduce -412 risk-control errors.
# Cookie is optional but can improve reliability for your own logged-in session.
BILIBILI_COOKIE=
BILIBILI_BIN=bili
BILIBILI_SEARCH_DELAY_MS=1200
BILIBILI_REQUEST_RATE=800ms
BILIBILI_RETRIES=2
# Download uses several yt-dlp format strategies. 3 = 1080p A/V -> best A/V -> single-file fallback.
BILIBILI_DOWNLOAD_ATTEMPTS=3
BILIBILI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36

# Persistent/resumable job queue. The DB lives inside downloads so the bind mount preserves it.
JOB_DB_PATH=/app/downloads/videoget.db
DOWNLOAD_CONCURRENCY=3
JOB_TIMEOUT_MINUTES=180

# Keyword expansion for Douyin/Bilibili discovery: ollama | off
KEYWORD_EXPANDER=ollama

# Automatically transcribe -> translate -> Vietnamese TTS -> render after download.
AUTO_LOCALIZE=true
LOCALIZE_SCRIPT=/app/scripts/localize_fast.py
LOCALIZE_CONCURRENCY=1

# Persistent Python worker keeps faster-whisper loaded instead of reloading it for every video.
LOCALIZE_PERSISTENT_WORKER=true
LOCALIZE_WORKER_SCRIPT=/app/scripts/localize_worker.py
LOCALIZE_WORKER_FALLBACK=true
# Preload Whisper when the app starts so the first localization job is faster.
LOCALIZE_WORKER_PREWARM=true
LOCALIZE_WORKER_START_TIMEOUT_SEC=600

# faster-whisper fast defaults for Chinese Douyin/Bilibili clips.
# Use small instead of base if you prefer accuracy over speed.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=1
# Decode MP4/MKV directly with PyAV; automatically falls back to a temporary 16 kHz WAV if needed.
WHISPER_DIRECT_DECODE=true
# Optional Hugging Face token: avoids anonymous Hub rate limits on first model download.
HF_TOKEN=

# Translation provider: ollama | openai | openai_compatible
TRANSLATE_PROVIDER=ollama
TRANSLATE_BATCH_SIZE=12
TRANSLATE_TIMEOUT_SEC=180
TRANSLATE_RETRIES=2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=15m

# Optional OpenAI-compatible translation endpoint instead of Ollama.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Vietnamese speech synthesis.
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+8%
TTS_MAX_SPEED=2.0
TTS_CONCURRENCY=4
TTS_RETRIES=2
# Several subtitle segments are grouped into one TTS request to reduce latency.
TTS_GROUP_MAX_CHARS=220
TTS_GROUP_MAX_DURATION_SEC=12
TTS_GROUP_MAX_GAP_SEC=1.2

# Final render: blur source burned-in captions/watermark zones, color-grade, then burn Vietnamese subtitles.
BURN_SUBTITLES=true
VIDEO_CLEANUP=true
VIDEO_CLEANUP_SOURCE_SUBTITLES=true
VIDEO_CLEANUP_LOGOS=true
# Normalized x,y,width,height. Defaults cover common top-right and bottom-right watermark zones.
# Adjust these per source/template if the watermark is elsewhere.
VIDEO_LOGO_MASKS=0.76,0.02,0.22,0.10;0.76,0.86,0.22,0.12
VIDEO_LOGO_BLUR=12
# Bottom source-caption band. Values are normalized to frame width/height.
VIDEO_SUBTITLE_MASK_X=0.02
VIDEO_SUBTITLE_MASK_Y=0.72
VIDEO_SUBTITLE_MASK_W=0.96
VIDEO_SUBTITLE_MASK_H=0.24
VIDEO_SUBTITLE_BLUR=14
VIDEO_COLOR_GRADE=true
VIDEO_CONTRAST=1.04
VIDEO_SATURATION=1.08
VIDEO_BRIGHTNESS=0.01
VIDEO_PRESET=veryfast
VIDEO_CRF=21
# 0 = remove original audio completely; 0.08 keeps a quiet copy underneath the Vietnamese voice.
ORIGINAL_AUDIO_VOLUME=0.08
