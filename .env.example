# Douyin web search/download requires a valid Cookie from your own logged-in browser session.
# Never commit a real cookie.
DOUYIN_COOKIE=

# Bilibili search uses bilibili-cli and is deliberately throttled to reduce -412 risk-control errors.
# Cookie is optional but can improve reliability for your own logged-in session.
BILIBILI_COOKIE=
BILIBILI_BIN=bili
BILIBILI_SEARCH_DELAY_MS=1200
BILIBILI_REQUEST_RATE=800ms
BILIBILI_RETRIES=2

# Keyword expansion for Douyin/Bilibili discovery: ollama | off
KEYWORD_EXPANDER=ollama

# Automatically transcribe -> translate -> Vietnamese TTS -> render after download.
AUTO_LOCALIZE=true

# faster-whisper. "small" is the default CPU-friendly compromise.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Translation provider: ollama | openai | openai_compatible
TRANSLATE_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional OpenAI-compatible translation endpoint instead of Ollama.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Vietnamese speech synthesis.
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_MAX_SPEED=2.0

# Render settings.
BURN_SUBTITLES=true
# 0 = remove original audio completely; 0.08 keeps a quiet copy underneath the Vietnamese voice.
ORIGINAL_AUDIO_VOLUME=0.08
